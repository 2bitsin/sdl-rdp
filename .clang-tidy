# Private names deliberately use leading underscores; disable the reserved-identifier check and its CERT aliases.
Checks: >
  bugprone-*, cert-*, clang-analyzer-*, concurrency-*, cppcoreguidelines-*,
  misc-*, modernize-*, performance-*, portability-*, readability-*,
  -cppcoreguidelines-non-private-member-variables-in-classes, -concurrency-mt-unsafe,
  -readability-magic-numbers, -cppcoreguidelines-avoid-magic-numbers, -readability-identifier-length,
  -readability-braces-around-statements,
  -cppcoreguidelines-pro-bounds-*, -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-union-access, -cppcoreguidelines-owning-memory,
  -misc-non-private-member-variables-in-classes, -misc-include-cleaner,
  -readability-identifier-naming, -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier, -cert-dcl37-c, -cert-dcl51-cpp, -readability-uppercase-literal-suffix, -readability-implicit-bool-conversion,
  -modernize-use-nodiscard, -cert-err58-cpp, -cppcoreguidelines-avoid-do-while,
  -readability-avoid-nested-conditional-operator, -performance-enum-size
WarningsAsErrors: '*'
HeaderFilterRegex: 'sources/(sdl-rdp/[^/]+|sample)/.*\.(hpp|cpp)$'
ExcludeHeaderFilterRegex: '/(third-party|_build|_bdudata)/'
CheckOptions:
  readability-function-size.LineThreshold: 40
  readability-function-size.StatementThreshold: 60
  readability-function-size.ParameterThreshold: 8
  readability-function-size.NestingThreshold: 4
  readability-function-cognitive-complexity.Threshold: 20
  # gtest macros expand to switch/if blockers, not the test's own flow; per-lane config is buildutil #154
  readability-function-cognitive-complexity.IgnoreMacros: true
  cppcoreguidelines-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
  # utilities::Pinned deletes copy and move, so a class inheriting it states C.21 through its base.
  cppcoreguidelines-special-member-functions.AllowImplicitlyDeletedCopyOrMove: true
  cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted: true
