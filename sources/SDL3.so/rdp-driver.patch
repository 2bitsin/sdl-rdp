diff -ruN a/src/audio/rdp/SDL_rdpaudio.c b/src/audio/rdp/SDL_rdpaudio.c
--- a/src/audio/rdp/SDL_rdpaudio.c
+++ b/src/audio/rdp/SDL_rdpaudio.c
@@ -0,0 +1,103 @@
+#include "SDL_internal.h"
+#include "SDL_rdpaudio.h"
+
+static void RDPAUDIO_DetectDevices(SDL_AudioDevice **playback, SDL_AudioDevice **recording)
+{
+    const SDL_AudioSpec spec = {SDL_AUDIO_S16, 2, 44100};
+    *playback = SDL_AddAudioDevice(false, "RDP client", &spec, NULL);
+}
+
+static bool RDPAUDIO_OpenDevice(SDL_AudioDevice *device)
+{
+    device->hidden = SDL_calloc(1, sizeof(*device->hidden));
+    if (!device->hidden) return false;
+    sdlrdp_config config;
+    if (!SDL_RDP_AcquireBackend(&device->hidden->backend, &device->hidden->handle, &config)) return false;
+    const int lead = SDL_RDP_GetInteger(SDL_HINT_RDP_AUDIO_LEAD, 150);
+    if (lead < 0) return SDL_SetError("Invalid RDP audio lead");
+    if ((unsigned)lead >= config.audio_latency_ms)
+        return SDL_SetError("RDP audio lead must be below the audio latency window");
+    device->hidden->lead = SDL_MS_TO_NS((Uint64)lead);
+    device->spec.format = SDL_AUDIO_S16;
+    device->spec.channels = 2;
+    device->spec.freq = 44100;
+    device->sample_frames = device->spec.freq / 100;
+    SDL_UpdatedAudioDeviceFormat(device);
+    if (device->hidden->backend.audio_open(device->hidden->handle) < 0) {
+        return SDL_SetError("%s", device->hidden->backend.last_error());
+    }
+    device->hidden->mixbuf = SDL_malloc(device->buffer_size);
+    device->hidden->next = SDL_GetTicksNS();
+    return device->hidden->mixbuf != NULL;
+}
+
+static bool RDPAUDIO_WaitDevice(SDL_AudioDevice *device)
+{
+    struct SDL_PrivateAudioData *data = device->hidden;
+    int result;
+    do {
+        result = data->backend.audio_wait(data->handle, 100);
+    } while (!result && !SDL_GetAtomicInt(&device->shutdown));
+    if (result < 0) return SDL_SetError("%s", data->backend.last_error());
+    const unsigned rate = data->backend.audio_rate(data->handle);
+    if (rate && device->spec.freq && rate != (unsigned)device->spec.freq) {
+        SDL_AudioSpec newspec = device->spec;
+        newspec.freq = (int)rate;
+        if (!SDL_AudioDeviceFormatChanged(device, &newspec, newspec.freq / 100)) return false;
+        Uint8 *mixbuf = SDL_realloc(data->mixbuf, device->buffer_size);
+        if (!mixbuf) return false;
+        data->mixbuf = mixbuf;
+    }
+    const Uint64 now = SDL_GetTicksNS();
+    if (rate && !data->rate) data->next = now;
+    data->rate = rate;
+    data->next += (Uint64)device->sample_frames * SDL_NS_PER_SECOND / device->spec.freq;
+    if (data->next > now + data->lead) SDL_DelayNS(data->next - now - data->lead);
+    else if (data->next < now) data->next = now;
+    return true;
+}
+
+static bool RDPAUDIO_PlayDevice(SDL_AudioDevice *device, const Uint8 *buffer, int buflen)
+{
+    struct SDL_PrivateAudioData *data = device->hidden;
+    const unsigned frames = buflen / (2 * sizeof(Sint16));
+    const unsigned rate = data->backend.audio_rate(data->handle);
+    if (rate && rate != (unsigned)device->spec.freq) return true;
+    if (data->backend.audio_write(data->handle, buffer, frames) != (int)frames) {
+        return SDL_SetError("%s", data->backend.last_error());
+    }
+    return true;
+}
+
+static Uint8 *RDPAUDIO_GetDeviceBuf(SDL_AudioDevice *device, int *size)
+{
+    return device->hidden->mixbuf;
+}
+
+static void RDPAUDIO_CloseDevice(SDL_AudioDevice *device)
+{
+    if (device->hidden) {
+        if (device->hidden->handle) {
+            device->hidden->backend.audio_close(device->hidden->handle);
+            SDL_RDP_ReleaseBackend();
+        }
+        SDL_free(device->hidden->mixbuf);
+        SDL_free(device->hidden);
+        device->hidden = NULL;
+    }
+}
+
+static bool RDPAUDIO_Init(SDL_AudioDriverImpl *impl)
+{
+    impl->DetectDevices = RDPAUDIO_DetectDevices;
+    impl->OpenDevice = RDPAUDIO_OpenDevice;
+    impl->CloseDevice = RDPAUDIO_CloseDevice;
+    impl->WaitDevice = RDPAUDIO_WaitDevice;
+    impl->PlayDevice = RDPAUDIO_PlayDevice;
+    impl->GetDeviceBuf = RDPAUDIO_GetDeviceBuf;
+    return true;
+}
+
+AudioBootStrap RDPAUDIO_bootstrap = {
+    "rdp", "SDL RDP audio driver", RDPAUDIO_Init, true, false
+};
