diff -ruN a/src/storage/rdp/SDL_rdpstorage.c b/src/storage/rdp/SDL_rdpstorage.c
--- a/src/storage/rdp/SDL_rdpstorage.c
+++ b/src/storage/rdp/SDL_rdpstorage.c
@@ -0,0 +1,150 @@
+#include "SDL_internal.h"
+#include "../SDL_sysstorage.h"
+#include "SDL_rdpdrive.h"
+
+typedef struct RDP_Storage {
+    SDL_RDP_Backend backend;
+    sdlrdp_handle *handle;
+    char *name;
+    unsigned drive;
+} RDP_Storage;
+
+static bool RDP_StorageClose(void *userdata)
+{
+    RDP_Storage *data = userdata;
+    SDL_RDP_ReleaseBackend();
+    SDL_free(data->name);
+    SDL_free(data);
+    return true;
+}
+
+static bool RDP_StorageReady(void *userdata)
+{
+    RDP_Storage *data = userdata;
+    return SDL_RDP_FindDrive(&data->backend, data->handle, data->name, &data->drive);
+}
+
+static bool RDP_StorageInfo(void *userdata, const char *path, SDL_PathInfo *info)
+{
+    RDP_Storage *data = userdata;
+    sdlrdp_stat value;
+    if (data->backend.drive_stat(data->handle, data->drive, path, &value) < 0)
+        return SDL_SetError("%s", data->backend.last_error());
+    SDL_zero(*info);
+    info->type = value.directory ? SDL_PATHTYPE_DIRECTORY : SDL_PATHTYPE_FILE;
+    info->size = value.size;
+    info->modify_time = SDL_SECONDS_TO_NS(value.modified);
+    return true;
+}
+
+static bool RDP_StorageEnumerate(void *userdata, const char *path, SDL_EnumerateDirectoryCallback callback, void *user)
+{
+    RDP_Storage *data = userdata;
+    sdlrdp_dirent entries[32];
+    unsigned offset = 0;
+    char *directory;
+    SDL_asprintf(&directory, "%s%s", path, *path && path[SDL_strlen(path)-1] != '/' ? "/" : "");
+    if (!directory) return false;
+    for (;;) {
+        int count = data->backend.drive_enumerate(data->handle, data->drive, path, offset, entries, SDL_arraysize(entries));
+        if (count < 0) {
+            SDL_free(directory);
+            return SDL_SetError("%s", data->backend.last_error());
+        }
+        for (int i = 0; i < count; ++i) {
+            SDL_EnumerationResult result = callback(user, directory, entries[i].name);
+            if (result != SDL_ENUM_CONTINUE) { SDL_free(directory); return result == SDL_ENUM_SUCCESS; }
+        }
+        offset += count;
+        if ((size_t)count < SDL_arraysize(entries)) break;
+    }
+    SDL_free(directory);
+    return true;
+}
+
+static bool RDP_StorageRead(void *userdata, const char *path, void *buffer, Uint64 length)
+{
+    RDP_Storage *data = userdata;
+    if (length > SDL_SIZE_MAX) return SDL_SetError("RDP storage read too large");
+    SDL_IOStream *file = SDL_RDP_OpenFile(data->name, path, "rb");
+    if (!file) return false;
+    bool ok = SDL_ReadIO(file, buffer, (size_t)length) == length;
+    bool closed = SDL_CloseIO(file);
+    return ok && closed;
+}
+
+static bool RDP_StorageWrite(void *userdata, const char *path, const void *buffer, Uint64 length)
+{
+    RDP_Storage *data = userdata;
+    if (length > SDL_SIZE_MAX) return SDL_SetError("RDP storage write too large");
+    SDL_IOStream *file = SDL_RDP_OpenFile(data->name, path, "wb");
+    if (!file) return false;
+    bool ok = SDL_WriteIO(file, buffer, (size_t)length) == length;
+    bool closed = SDL_CloseIO(file);
+    return ok && closed;
+}
+
+static bool RDP_StorageMkdir(void *userdata, const char *path)
+{
+    RDP_Storage *data = userdata;
+    return data->backend.drive_mkdir(data->handle, data->drive, path) >= 0 || SDL_SetError("%s", data->backend.last_error());
+}
+
+static bool RDP_StorageRemove(void *userdata, const char *path)
+{
+    RDP_Storage *data = userdata;
+    return data->backend.drive_remove(data->handle, data->drive, path) >= 0 || SDL_SetError("%s", data->backend.last_error());
+}
+
+static bool RDP_StorageRename(void *userdata, const char *from, const char *to)
+{
+    RDP_Storage *data = userdata;
+    return data->backend.drive_rename(data->handle, data->drive, from, to) >= 0 || SDL_SetError("%s", data->backend.last_error());
+}
+
+static bool RDP_StorageCopy(void *userdata, const char *from, const char *to)
+{
+    RDP_Storage *data = userdata;
+    if (!SDL_strcmp(from, to)) return SDL_SetError("RDP copy source equals destination");
+    SDL_IOStream *source = SDL_RDP_OpenFile(data->name, from, "rb");
+    if (!source) return false;
+    SDL_IOStream *target = SDL_RDP_OpenFile(data->name, to, "wb");
+    bool ok = target != NULL;
+    Uint8 buffer[65536];
+    while (ok) {
+        size_t count = SDL_ReadIO(source, buffer, sizeof(buffer));
+        if (!count) { ok = SDL_GetIOStatus(source) == SDL_IO_STATUS_EOF; break; }
+        ok = SDL_WriteIO(target, buffer, count) == count;
+    }
+    if (target && !SDL_CloseIO(target)) ok = false;
+    if (!SDL_CloseIO(source)) ok = false;
+    return ok;
+}
+
+static Uint64 RDP_StorageSpace(void *userdata) { return 0; }
+
+static const SDL_StorageInterface RDP_storage_interface = {
+    sizeof(SDL_StorageInterface), RDP_StorageClose, RDP_StorageReady, RDP_StorageEnumerate,
+    RDP_StorageInfo, RDP_StorageRead, RDP_StorageWrite, RDP_StorageMkdir, RDP_StorageRemove,
+    RDP_StorageRename, RDP_StorageCopy, RDP_StorageSpace
+};
+
+static SDL_Storage *RDP_StorageOpen(const char *name, SDL_PropertiesID props)
+{
+    RDP_Storage *data = SDL_calloc(1, sizeof(*data));
+    if (!data) return NULL;
+    if (!SDL_RDP_AcquireBackend(&data->backend, &data->handle, NULL)) { SDL_free(data); return NULL; }
+    data->name = SDL_strdup(name ? name : "");
+    if (!data->name) { RDP_StorageClose(data); return NULL; }
+    SDL_Storage *storage = SDL_OpenStorage(&RDP_storage_interface, data);
+    if (!storage) RDP_StorageClose(data);
+    return storage;
+}
+
+static SDL_Storage *RDP_UserStorageOpen(const char *org, const char *app, SDL_PropertiesID props)
+{
+    return RDP_StorageOpen(app, props);
+}
