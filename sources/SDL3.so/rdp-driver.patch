+ * May be changed while the video subsystem is running.
+ */
+#define SDL_HINT_RDP_CODEC "SDL_RDP_CODEC"
+
+
+/**
+ * A variable controlling the initial RDP display height in pixels.
+ *
+ * The default is "768".
+ *
+ * This hint should be set before initializing the video subsystem.
+ *
+ * \since This hint is available since SDL 3.4.8.
+ */
+#define SDL_HINT_RDP_HEIGHT "SDL_RDP_HEIGHT"
+
+/**
+ * A variable controlling the RDP listener port.
+ *
+ * The default is "3389". A value of "0" selects an ephemeral port.
+ *
+ * This hint should be set before initializing the video subsystem.
+ *
+ * \since This hint is available since SDL 3.4.8.
+ */
+#define SDL_HINT_RDP_PORT "SDL_RDP_PORT"
+
+/**
+ * A variable controlling whether RDP initialization waits for a client.
+ *
+ * The default is "0". Set to "1" to wait for client activation.
+ *
+ * This hint should be set before initializing the video subsystem.
+ *
+ * \since This hint is available since SDL 3.4.8.
+ */
+#define SDL_HINT_RDP_WAIT_FOR_CLIENT "SDL_RDP_WAIT_FOR_CLIENT"
+
+/**
+ * A variable controlling the initial RDP display width in pixels.
+ *
+ * The default is "1024".
+ *
+ * This hint should be set before initializing the video subsystem.
+ *
+ * \since This hint is available since SDL 3.4.8.
+ */
+#define SDL_HINT_RDP_WIDTH "SDL_RDP_WIDTH"
+
