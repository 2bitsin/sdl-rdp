+/**
+ * A variable controlling the numeric IPv4 address for the RDP listener.
+ *
+ * The default is "0.0.0.0".
+ *
+ * This hint should be set before initializing the video subsystem.
+ *
+ * \since This hint is available since SDL 3.4.8.
+ */
+#define SDL_HINT_RDP_BIND "SDL_RDP_BIND"
+
+/**
+ * A variable controlling the directory containing RDP TLS certificates.
+ *
+ * The default is "_rdp" in the current working directory.
