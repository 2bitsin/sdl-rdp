+const char *SDL_GetHintFromCode(const char *name)
+{
+    const char *result = NULL;
+    const SDL_PropertiesID hints = GetHintProperties(false);
+    if (name && hints) {
+        SDL_Hint *hint;
+        SDL_LockProperties(hints);
+        hint = (SDL_Hint *)SDL_GetPointerProperty(hints, name, NULL);
+        if (hint) result = SDL_GetPersistentString(hint->value);
+        SDL_UnlockProperties(hints);
+    }
+    return result;
+}
